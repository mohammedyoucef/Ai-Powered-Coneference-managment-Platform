# Confexa requires PostgreSQL and (optionally) a Meta model key.
# Copy to .env.local and fill in real values. Never commit .env.local.

# PostgreSQL (required). Local: `docker compose up -d db` then:
DATABASE_URL=postgres://confexa:confexa_dev_password@localhost:5432/confexa
# Hosted Postgres (e.g. Supabase Postgres connection string) also works;
# set DATABASE_SSL=true if your provider requires TLS:
DATABASE_SSL=false

# First registered user becomes platform_admin. Or list admin emails:
PLATFORM_ADMIN_EMAILS=

# Uploaded PDFs are stored under this directory (server-only, never public):
CONFEXA_UPLOAD_DIR=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta model API (optional — labeled deterministic fallback runs without it).
# Recommended: paste your key in the app Profile page instead (per-user, browser-held).
MODEL_API_KEY=
META_MODEL_NAME=muse-wonder-1.0
META_MODEL_ENDPOINT=https://api.meta.ai/v1/responses

# Email (optional). Without SMTP_HOST, notifications are in-app only and are
# honestly labeled "not configured" — nothing is claimed as emailed.
SMTP_HOST=

# Payments (optional). No provider SDK is bundled: paid visitor registration
# only becomes collectable with a real provider integration that confirms
# payment via signed webhooks. Without these, paid applications stay in the
# honest "unconfigured" payment state and nothing is ever marked as paid.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
